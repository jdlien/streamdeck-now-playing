<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Device state and contracts: what the plugin knows about Stream Deck and
    monitor brightness, independent of how a platform talks to the hardware.
    The implementations live in NowPlaying.Device.Windows and, for monitors,
    NowPlaying.Device.Mac (macos-port-plan D1).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NowPlaying.Device</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NowPlaying.Media.Tests" />
    <InternalsVisibleTo Include="NowPlaying.Device.Windows" />
  </ItemGroup>

</Project>
