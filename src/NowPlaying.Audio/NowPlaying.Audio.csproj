<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The system-volume contract and its snapshot. No Stream Deck dependency,
    like NowPlaying.Media, and no platform dependency: the implementations live
    in NowPlaying.Audio.Windows and (from the macOS port) NowPlaying.Audio.Mac.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NowPlaying.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
