<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The media model: snapshots, ranking, timeline maths, and the
    IMediaSessionService contract. No Stream Deck dependency and, since the
    macOS port, no platform dependency either. The Windows implementation
    lives in NowPlaying.Media.Windows (macos-port-plan D1).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NowPlaying.Media</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NowPlaying.Media.Tests" />
    <!-- The platform implementations are peers of this assembly, not consumers of its public API. -->
    <InternalsVisibleTo Include="NowPlaying.Media.Windows" />
  </ItemGroup>

</Project>
