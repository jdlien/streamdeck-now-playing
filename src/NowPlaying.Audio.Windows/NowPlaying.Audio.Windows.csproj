<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows implementation of IVolumeService: Core Audio's
    IAudioEndpointVolume through NAudio's WASAPI package. Split out of
    NowPlaying.Audio so the interface and the snapshot stay platform-neutral
    (macos-port-plan D1).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NowPlaying.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NowPlaying.Audio\NowPlaying.Audio.csproj" />
  </ItemGroup>

</Project>
