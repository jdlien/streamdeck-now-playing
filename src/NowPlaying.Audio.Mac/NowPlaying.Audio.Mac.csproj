<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The macOS implementation of IVolumeService, over CoreAudio. All public API,
    so no entitlement and no permission prompt.

    Targets plain net10.0 rather than net10.0-macos: nothing here needs the
    Apple bindings, only P/Invoke, and a neutral target keeps the plugin's
    non-Windows build a single TFM. Callers guard on OperatingSystem.IsMacOS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NowPlaying.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NowPlaying.Audio\NowPlaying.Audio.csproj" />
  </ItemGroup>

</Project>
