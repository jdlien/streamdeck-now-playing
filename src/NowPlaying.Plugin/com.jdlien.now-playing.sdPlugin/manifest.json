{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.jdlien.now-playing",
  "Name": "Now Playing",
  "Version": "0.5.0.0",
  "Author": "JD Lien",
  "Description": "Now playing on a Stream Deck + dial or a key, with album art, progress, and playback control, plus matching dials for volume, Stream Deck brightness, and monitor brightness.",
  "URL": "https://github.com/jdlien/streamdeck-now-playing",
  "Icon": "imgs/plugin/marketplace",
  "Category": "Now Playing",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/NowPlaying.exe",
  "CodePathWin": "bin/NowPlaying.exe",
  "CodePathMac": "bin/mac/NowPlaying",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "14"
    }
  ],
  "Actions": [
    {
      "UUID": "com.jdlien.now-playing.dial",
      "Name": "Now Playing",
      "Tooltip": "Shows the current track on the touch strip. Turn for next or previous track, press or tap for play/pause.",
      "Icon": "imgs/actions/now-playing/icon",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "pi/dial.html",
      "Encoder": {
        "layout": "layouts/now-playing.json",
        "TriggerDescription": {
          "Rotate": "Next / previous track",
          "Push": "Play / pause",
          "Touch": "Play / pause"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/now-playing/key"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "UUID": "com.jdlien.now-playing.key",
      "Name": "Now Playing Key",
      "Tooltip": "Album art, title, and play state on a key. Press for play/pause, hold for next track; both configurable.",
      "Icon": "imgs/actions/now-playing-key/icon",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "pi/key.html",
      "States": [
        {
          "Image": "imgs/actions/now-playing-key/key"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "UUID": "com.jdlien.now-playing.volume",
      "Name": "Volume",
      "Tooltip": "System volume on the touch strip, in the same layout as Now Playing. Turn to adjust, press or tap to mute.",
      "Icon": "imgs/actions/volume/icon",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "pi/volume.html",
      "Encoder": {
        "layout": "layouts/volume.json",
        "TriggerDescription": {
          "Rotate": "Volume",
          "Push": "Mute",
          "Touch": "Mute"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/volume/key"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "UUID": "com.jdlien.now-playing.brightness",
      "Name": "SD Brightness",
      "Tooltip": "Stream Deck screen brightness on the touch strip, in the same layout. Turn to adjust, press or tap to dim and restore.",
      "OS": [
        {
          "Platform": "windows",
          "MinimumVersion": "10"
        }
      ],
      "Icon": "imgs/actions/brightness/icon",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "pi/brightness.html",
      "Encoder": {
        "layout": "layouts/brightness.json",
        "TriggerDescription": {
          "Rotate": "Brightness",
          "Push": "Dim / restore",
          "Touch": "Dim / restore"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/brightness/key"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "UUID": "com.jdlien.now-playing.display-brightness",
      "Name": "Display Brightness",
      "Tooltip": "Brightness of a monitor (over DDC/CI) or of the Stream Deck itself, in the same layout. Each dial picks its own screen and can cycle through all of them. Turn to adjust; press, tap, and hold are configurable.",
      "Icon": "imgs/actions/display-brightness/icon",
      "Controllers": [
        "Encoder"
      ],
      "PropertyInspectorPath": "pi/display-brightness.html",
      "Encoder": {
        "layout": "layouts/display-brightness.json",
        "TriggerDescription": {
          "Rotate": "Brightness",
          "Push": "Dim / restore",
          "Touch": "Next screen",
          "LongTouch": "Previous screen"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/display-brightness/key"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    }
  ]
}
