{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "com.jdlien.now-playing.layout",
  "items": [
    {
      "key": "icon",
      "type": "pixmap",
      "rect": [ 8, 8, 24, 24 ],
      "zOrder": 1,
      "value": "imgs/icons/pause.svg"
    },
    {
      "key": "track",
      "type": "text",
      "rect": [ 38, 4, 158, 30 ],
      "zOrder": 1,
      "alignment": "left",
      "font": { "size": 18, "weight": 600 },
      "text-overflow": "ellipsis",
      "color": "white",
      "value": "No media"
    },
    {
      "key": "artist",
      "type": "text",
      "rect": [ 38, 36, 158, 26 ],
      "zOrder": 1,
      "alignment": "left",
      "font": { "size": 14, "weight": 400 },
      "text-overflow": "ellipsis",
      "color": "lightGray",
      "value": ""
    },
    {
      "key": "progress",
      "type": "bar",
      "rect": [ 8, 76, 184, 14 ],
      "zOrder": 1,
      "subtype": 0,
      "border_w": 0,
      "range": { "min": 0, "max": 1000 },
      "bar_bg_c": "#333333",
      "bar_fill_c": "white",
      "value": 0,
      "enabled": false
    }
  ]
}
