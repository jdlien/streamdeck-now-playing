<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console harness for the media library (README section 3, decision 3).
    `probe` lists every session; milestone 1 adds `watch`, which prints a JSON
    line per snapshot change and takes next / prev / toggle on stdin.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NowPlaying.Media.Cli</RootNamespace>
    <AssemblyName>nowplaying-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NowPlaying.Media\NowPlaying.Media.csproj" />
    <ProjectReference Include="..\NowPlaying.Audio\NowPlaying.Audio.csproj" />
    <ProjectReference Include="..\NowPlaying.Device\NowPlaying.Device.csproj" />
  </ItemGroup>

</Project>
